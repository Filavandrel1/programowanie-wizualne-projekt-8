<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:projekt8plsdzialaj.ViewModels"
             x:Class="projekt8plsdzialaj.Views.GameView"
             x:DataType="vm:GameViewModelBase">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="{Binding Description}" Opacity="0.7"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto, *" Margin="0,16,0,0" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Gracz 1" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <Border Width="220" Height="320" CornerRadius="20" Background="White" BorderBrush="#333" BorderThickness="2" Padding="16">
                    <Grid>
                        <TextBlock Text="{Binding Player1Card}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Player1DeckCount, StringFormat=Karty: {0}}" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="VS" FontSize="36" FontWeight="Bold" Opacity="0.6"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Gracz 2" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <Border Width="220" Height="320" CornerRadius="20" Background="White" BorderBrush="#333" BorderThickness="2" Padding="16">
                    <Grid>
                        <TextBlock Text="{Binding Player2Card}" FontSize="64" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Player2DeckCount, StringFormat=Karty: {0}}" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,16" CornerRadius="12" Padding="24"
                Background="#1A1A1A" BorderBrush="#333" BorderThickness="1">
            <TextBlock Text="{Binding Status}"
                       Foreground="White"
                       FontSize="18"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button Content="🎴 Rozdaj"
                    Command="{Binding DealCommand}"
                    Padding="20,10" FontSize="16" FontWeight="SemiBold"/>
            <Button Content="🏳️ Poddaj się"
                    Command="{Binding SurrenderCommand}"
                    Padding="20,10" FontSize="16" FontWeight="SemiBold"
                    Background="#D84A4A" Foreground="White"
                    IsVisible="{Binding CanSurrender}"/>
            <Button Content="← Powrót do menu"
                    Command="{Binding BackCommand}"
                    Padding="20,10" FontSize="16"/>
        </StackPanel>
    </Grid>
</UserControl>

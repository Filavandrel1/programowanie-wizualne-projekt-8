<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:projekt8plsdzialaj.ViewModels"
             x:Class="projekt8plsdzialaj.Views.MenuView"
             x:DataType="vm:MenuViewModel">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Margin="24">
            <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="🎴 Hub Gier Karcianych"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Wybierz grę i naciśnij Start"
                           FontSize="14" Opacity="0.7"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <UniformGrid Grid.Row="1" Columns="3" Margin="0,32,0,0">
                <Border Margin="12" CornerRadius="12" Padding="20"
                        Background="#1E2A78" BorderBrush="#4A5BD8" BorderThickness="1">
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="⚔️" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wojna" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pojedynek na najwyższą kartę."
                                   TextWrapping="Wrap" Foreground="#CFD4FF"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Button Content="Start"
                                Command="{Binding StartWarCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10" FontSize="16" FontWeight="SemiBold"
                                Background="#4A5BD8" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Margin="12" CornerRadius="12" Padding="20"
                        Background="#0E5C3A" BorderBrush="#1FAE6B" BorderThickness="1">
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="🃏" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="Oczko" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Dobierz karty i nie przekrocz 21."
                                   TextWrapping="Wrap" Foreground="#C7F0DA"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Button Content="Start"
                                Command="{Binding StartBlackjackCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10" FontSize="16" FontWeight="SemiBold"
                                Background="#1FAE6B" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Margin="12" CornerRadius="12" Padding="20"
                        Background="#5A2E91" BorderBrush="#9B6BD8" BorderThickness="1">
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="🂡" FontSize="56" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pasjans" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ułóż karty na czas."
                                   TextWrapping="Wrap" Foreground="#E6D4FF"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Button Content="Start"
                                Command="{Binding StartSolitaireCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,10" FontSize="16" FontWeight="SemiBold"
                                Background="#9B6BD8" Foreground="White"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Button Grid.Row="2"
                    Content="📜 Historia rozgrywek"
                    Command="{Binding ShowHistoryCommand}"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Padding="16,10" FontSize="14" FontWeight="SemiBold"
                    Background="#333" Foreground="White"/>
        </Grid>

        <!-- Ukryta gra: czerwony przycisk z wykrzyknikiem -->
        <Button Command="{Binding StartHiLoCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,18,0"
                Width="48" Height="48"
                CornerRadius="24"
                Background="#C0202A" Foreground="White"
                BorderBrush="#FF5A5A" BorderThickness="2"
                Padding="0"
                FontSize="24" FontWeight="Bold"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="...?"
                Content="!"/>

        <Border IsVisible="{Binding IsLoginVisible}" Background="#CC000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1A1A1A" BorderBrush="#444" BorderThickness="1"
                    CornerRadius="12" Padding="28" MinWidth="400">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center">
                        <Run Text="Kto gra w grę:"/>
                        <Run Text="{Binding PendingGameTitle}" Foreground="#9B6BD8"/>
                        <Run Text="?"/>
                    </TextBlock>
                    <TextBlock Text="Podaj swoje imię, aby wynik trafił do historii."
                               Foreground="#BBB" FontSize="13"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBox Text="{Binding PlayerNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="np. Anna"
                             FontSize="16" Padding="8"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Anuluj"
                                Command="{Binding CancelLoginCommand}"
                                Padding="16,8"/>
                        <Button Content="Gram!"
                                Command="{Binding ConfirmLoginCommand}"
                                IsDefault="True"
                                Padding="16,8" FontWeight="SemiBold"
                                Background="#1FAE6B" Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
